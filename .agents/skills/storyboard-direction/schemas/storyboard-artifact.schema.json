{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "storyboard-artifact.schema.json",
  "title": "storyboard artifact (通用分镜产物)",
  "description": "与仓库 video_flow/contracts.py 的 artifact_check('storyboard') 对齐的文档化模式。场景集合须精确等于上游 story.items.id 集合、总时长与 brief.duration_seconds 差不超过 0.5 秒，这两条集合/总和约束由可执行契约强制，不在本模式内重复表达。",
  "type": "object",
  "required": ["task_id", "type", "items"],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "description": "与任务包一致的 task_id"
    },
    "type": {
      "const": "storyboard"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "scene_id", "beat", "action", "start_state", "end_state", "duration_seconds", "axis", "cut_motivation", "sound"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "镜头标识，全片唯一，如 C01、N01"
          },
          "scene_id": {
            "type": "string",
            "minLength": 1,
            "description": "上游 story 的场景标识，只能沿用不能新造或合并"
          },
          "beat": {
            "type": "string",
            "minLength": 1,
            "description": "该镜承担的节拍功能"
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "description": "可观察的动作，不是情绪形容词"
          },
          "start_state": {
            "type": "string",
            "minLength": 1,
            "description": "镜初可见状态，须与上一镜 end_state 相接"
          },
          "end_state": {
            "type": "string",
            "minLength": 1,
            "description": "镜末可见状态"
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "正数时长（秒）"
          },
          "axis": {
            "type": "string",
            "minLength": 1,
            "description": "轴线与机位，含景别与运动"
          },
          "cut_motivation": {
            "type": "string",
            "minLength": 1,
            "description": "切入本镜与切出本镜的事件动机"
          },
          "sound": {
            "type": "string",
            "minLength": 1,
            "description": "本镜声源与声音事件，含禁止项"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
