{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "required": ["schema_version", "type", "items"],
  "properties": {
    "schema_version": {"const": "0.2.0"}, "type": {"const": "story"},
    "items": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "scene_goal", "action", "location", "time", "characters", "dialogue", "duration_ms"], "properties": {
      "id": {"type": "string", "minLength": 1}, "scene_goal": {"type": "string", "minLength": 1}, "action": {"type": "string", "minLength": 1},
      "location": {"type": "string", "minLength": 1}, "time": {"type": "string", "minLength": 1},
      "characters": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "duration_ms": {"type": "integer", "minimum": 1},
      "dialogue": {"type": "array", "items": {"type": "object", "required": ["speaker_id", "text", "delivery_note"], "properties": {
        "speaker_id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}, "delivery_note": {"type": "string"}
      }}}
    }}}
  }
}
