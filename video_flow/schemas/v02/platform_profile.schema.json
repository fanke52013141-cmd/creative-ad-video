{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "profile_id", "status", "source", "verified_at", "modes"],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["verified", "user_supplied", "test_only", "unverified"]},
    "source": {"type": "string", "minLength": 1},
    "verified_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "modes": {
      "type": "object", "minProperties": 1, "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["min_duration_ms", "max_duration_ms", "max_images", "supports_multi_shot", "supports_audio"],
        "properties": {
          "min_duration_ms": {"type": "integer", "minimum": 1}, "max_duration_ms": {"type": "integer", "minimum": 1},
          "max_images": {"type": "integer", "minimum": 0}, "supports_multi_shot": {"type": "boolean"}, "supports_audio": {"type": "boolean"},
          "image_tag_template": {"type": "string", "minLength": 1},
          "aspect_ratios": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"}},
          "resolutions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
