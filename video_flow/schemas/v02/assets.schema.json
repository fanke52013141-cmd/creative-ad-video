{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "required": ["schema_version", "type", "items"],
  "properties": {
    "schema_version": {"const": "0.2.0"}, "type": {"const": "assets"},
    "items": {"type": "array", "items": {
      "type": "object", "required": ["id", "kind", "description", "continuity_rules", "display_name", "invariant_features", "states", "media_requirements", "shot_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "asset_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["character", "space", "prop"]}, "display_name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}, "continuity_rules": {"type": "string", "minLength": 1},
        "invariant_features": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "shot_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "states": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["state_id", "description", "shot_ids"], "properties": {
          "state_id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1},
          "shot_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }}},
        "media_requirements": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["reference_key", "state_id", "view", "required", "coverage_policy"], "properties": {
          "reference_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"}, "state_id": {"type": "string", "minLength": 1},
          "view": {"type": "string", "minLength": 1}, "required": {"type": "boolean"}, "coverage_policy": {"enum": ["independent", "scene_reference"]}
        }}}
      }
    }}
  }
}
