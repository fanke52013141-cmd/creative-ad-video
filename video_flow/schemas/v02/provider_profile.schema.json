{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "profile_id", "status", "supports_reference_images", "formats", "credential_env", "test_only"],
  "properties": {
    "schema_version": {"const": "0.2.0"}, "profile_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["verified", "user_supplied", "test_only", "unverified"]},
    "supports_reference_images": {"type": "boolean"}, "test_only": {"type": "boolean"},
    "credential_env": {"type": ["string", "null"], "minLength": 1},
    "formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["png", "jpeg", "webp"]}}
  }
}
