{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Storyboard Board Manifest",
  "type": "object",
  "required": ["schema_version", "boards"],
  "properties": {
    "schema_version": {"type": "string", "const": "2.0"},
    "boards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["board_id", "video_id", "shot_ids", "duration_seconds", "required_text", "packet_path", "prompt_path", "prompt_hash"],
        "properties": {
          "board_id": {"type": "string", "pattern": "^SB[0-9]{3}$"},
          "video_id": {"type": "string", "pattern": "^V[0-9]{3}$"},
          "shot_ids": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "pattern": "^S[0-9]{3}$"}},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 30},
          "required_text": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["shot_id", "content", "role", "placement", "presentation", "must_match_exactly"],
              "properties": {
                "shot_id": {"type": "string", "pattern": "^S[0-9]{3}$"},
                "content": {"type": "string", "minLength": 1},
                "role": {"type": "string"},
                "placement": {"type": "string"},
                "presentation": {"type": "string"},
                "must_match_exactly": {"const": true}
              },
              "additionalProperties": false
            }
          },
          "packet_path": {"type": "string"},
          "prompt_path": {"type": "string"},
          "prompt_hash": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
